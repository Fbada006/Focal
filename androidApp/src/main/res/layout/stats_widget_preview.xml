<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview (API 31+) of the stats widget's 3x1 layout, with sample numbers. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/stats_widget_preview_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/stats_widget_preview_today"
        android:textColor="#1B1B1F"
        android:textSize="14sp" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/stats_widget_preview_week"
        android:textColor="#1B1B1F"
        android:textSize="14sp" />

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="@string/stats_widget_preview_streak"
        android:textColor="#1B1B1F"
        android:textSize="14sp" />
</LinearLayout>
