<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The running-session notification and the Shield's Open Focal (story 4). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Keeps Focal alive and shows the running-session timer while a session runs (T13). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Running Focus Sessions are re-applied, and Schedule alarms re-armed, after a reboot (T13, T30). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Schedules start and end on time with Focal closed (T30). SCHEDULE_EXACT_ALARM, not
        USE_EXACT_ALARM: Play only allows USE_EXACT_ALARM for alarm-clock and calendar apps. The
        user grants it in "Alarms & reminders" when creating a Schedule.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!--
        Optional: ranks the Apps tab's suggestions by the last 7 days of system usage (story 16a).
        It is an app-op granted in Settings > Usage access, not a runtime prompt; without it the
        list stays alphabetical. Never used as a blocking signal.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lets Focal list launchable apps without QUERY_ALL_PACKAGES (T12). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Settings and the uninstaller are never Shielded (ADR 0002), so Focal resolves them (T13). -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.APPLICATION_DETAILS_SETTINGS" />
            <data android:scheme="package" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DELETE" />
            <data android:scheme="package" />
        </intent>
    </queries>

    <application
        android:name=".FocalApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Detects the foreground app and draws the Shield (T13). -->
        <service
            android:name="io.disruption.focal.blocking.FocalAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/focal_accessibility_service" />
        </service>

        <!-- Keeps blocking alive and shows the timer while any Focus Session runs (T13). -->
        <service
            android:name=".blocking.RunningSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Blocks distracting apps and websites during a Focus Session the user started or scheduled, and keeps its remaining time visible." />
        </service>

        <receiver
            android:name=".blocking.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Schedule alarms, clock and time-zone changes, and exact alarms being granted (T30). -->
        <receiver
            android:name=".blocking.ScheduleAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- The home-screen stats widget (story 75). -->
        <receiver
            android:name=".widget.StatsWidgetReceiver"
            android:exported="false"
            android:label="@string/stats_widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/stats_widget_info" />
        </receiver>
    </application>

</manifest>
